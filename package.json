{
  "name": "@lvce-editor/wsl-monorepo",
  "version": "0.0.0-dev",
  "description": "WSL2 support for Lvce Editor",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@lvce-editor/wsl",
    "test": "npm test --workspaces --if-present",
    "test:wsl": "npm run test:wsl --workspace=@lvce-editor/wsl",
    "type-check": "npm run type-check --workspace=@lvce-editor/wsl",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^18.13.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 150
  }
}
