{
  "id": "lvce.wsl",
  "name": "WSL",
  "description": "Open workspaces hosted in Windows Subsystem for Linux",
  "browser": "dist/wslWorkerMain.js",
  "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'", "connect-src 'self' ws://127.0.0.1:* ws://localhost:*"],
  "rpc": [
    {
      "id": "lvce.wsl.node",
      "type": "node-process",
      "name": "WSL",
      "url": "dist/node/wslNodeMain.js"
    }
  ],
  "isolated": true,
  "preserveRuntimeOnWorkspaceChange": true,
  "compatibility": {
    "web": false
  },
  "fileSystemProviders": [
    {
      "id": "wsl"
    }
  ],
  "activation": ["onCommand:wsl.connect", "onFileSystem:wsl"],
  "commands": [
    {
      "id": "wsl.connect",
      "label": "WSL: Connect to WSL"
    }
  ],
  "version": "0.0.0-dev"
}
